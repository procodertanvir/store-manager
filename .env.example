# When you attach a Vercel Postgres database to this project in the
# Vercel dashboard, these are created for you automatically — you do
# NOT need to fill them in by hand for deployment.
#
# For local development, run `vercel env pull .env.local` after linking
# the project, and it will fetch these for you.

POSTGRES_URL=
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=
POSTGRES_USER=
POSTGRES_HOST=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=
